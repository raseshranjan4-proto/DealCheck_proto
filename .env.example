# Copy to .env for local use. NEVER commit .env. NEVER put the service-role key in
# frontend code — it bypasses RLS.

# --- Supabase project: nggfbjwpdggrezhtasys ---------------------------------
SUPABASE_PROJECT_REF=nggfbjwpdggrezhtasys
SUPABASE_URL=https://nggfbjwpdggrezhtasys.supabase.co

# Public, read-only (RLS allows select only). Safe to embed in the frontend.
# Dashboard > Project Settings > API > Project API keys > anon / public
SUPABASE_ANON_KEY=

# SECRET. Server-side only (Edge Function, cron, dry-run scripts). Bypasses RLS.
# Dashboard > Project Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ------------------------------------------------------------------
# https://console.anthropic.com/settings/keys  — set as a Supabase secret, not here,
# for the deployed function:  supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# --- Pipeline knobs (optional) ------------------------------------------------
# Max articles to run through extraction per invocation (newest first).
PIPELINE_MAX_ARTICLES_PER_RUN=60
